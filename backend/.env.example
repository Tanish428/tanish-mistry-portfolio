# Application
NODE_ENV=development
PORT=5000

# Reverse Proxy Configuration
# Controls Express 'trust proxy' setting for accurate client IP resolution behind reverse proxies or load balancers.
# Options:
#   - false: Direct connection / local development (default; disables trusting X-Forwarded-* headers)
#   - true: Trust the first upstream client address in X-Forwarded-For (use only if the proxy sanitizes headers)
#   - 1, 2, ...: Number of trusted reverse proxy hops (e.g., 1 for Render, Railway, AWS ALB, Heroku, Cloudflare)
#   - loopback, linklocal, uniquelocal, or specific CIDR/IP list (e.g. 10.0.0.0/8, 127.0.0.1)
# Production note: Must match your actual hosting proxy topology. Do not set to true or 1 in direct (non-proxied) deployments.
TRUST_PROXY=false

# Database
MONGODB_URI=your_mongodb_connection_string
DB_NAME=tanish_portfolio

# Frontend
CLIENT_URL=http://localhost:5173

# Authentication & JWT
JWT_SECRET=your_long_random_jwt_secret_min_32_characters
JWT_EXPIRES_IN=15m
JWT_ISSUER=tanish-portfolio-api
JWT_AUDIENCE=tanish-portfolio-admin

# Authentication Cookie Configuration
# - AUTH_COOKIE_NAME: Name of the HttpOnly JWT cookie.
# - AUTH_COOKIE_SECURE: Set to false for local HTTP development; MUST be true in production over HTTPS.
# - AUTH_COOKIE_SAME_SITE:
#     - 'lax': Recommended when frontend and API share the same apex domain (e.g., app.domain.com and api.domain.com).
#     - 'none': REQUIRED when frontend and backend are hosted on separate domains (e.g., vercel.app calling onrender.com).
#               Browsers mandate that SameSite=None cookies MUST also have AUTH_COOKIE_SECURE=true (HTTPS).
#     - 'strict': Maximum isolation; cookie is never sent on cross-site navigations.
AUTH_COOKIE_NAME=portfolio_admin_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# CSRF Protection
CSRF_SECRET=your_long_random_csrf_secret_min_32_characters

# Administrator Provisioning (used only by scripts/create-admin.js)
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_secure_password_min_12_chars

# Cloudinary Media Management
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=portfolio

